# Bluesky Authentication
# Get your app password from: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=your-app-password

# Database Connection
# Copy from your Railway musicgenre.site environment variables
DATABASE_URL=postgresql://username:password@host:port/database

# Last.fm API (for fetching tracks)
# Copy from your musicgenre.site app
LASTFM_API_KEY=your-lastfm-api-key

# Site URL
SITE_URL=https://musicgenre.site

# Optional: Node environment
NODE_ENV=production
